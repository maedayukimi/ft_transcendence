# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored and must never be committed.

# PostgreSQL credentials (used by the postgres and backend services)
DATABASE_USER=changeme
DATABASE_PASSWORD=changeme
DATABASE_NAME=werewolf-gamedb

# Secret used to sign/verify JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme
